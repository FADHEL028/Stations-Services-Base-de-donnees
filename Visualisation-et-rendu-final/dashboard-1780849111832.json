      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "comparaison_prix_Gazole",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dfn9fz0bqdu68d"
                      },
                      "spec": {
                        "dataset": "station",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH PrixMoyenCarburant AS (\n    -- 1. On calcule d'abord la moyenne nationale pour situer le contexte\n    SELECT AVG(prix) AS moyenne_nationale\n    FROM prix_detail\n    WHERE nom_carburant='Gazole'\n)\n-- 2. On sélectionne et compare les stations\nSELECT \n    s.id_station,\n    s.localisation,\n    p.prix AS prix_station,\n    ROUND(p.prix - pm.moyenne_nationale, 3) AS ecart_a_la_moyenne,\n    -- Optionnel : calcul du pourcentage d'économie pour l'entreprise\n    ROUND(((pm.moyenne_nationale - p.prix) / pm.moyenne_nationale) * 100, 1) AS pourcentage_economie\nFROM \n    Station s\nJOIN \n    prix_detail p ON s.id_station = p.id_station\nCROSS JOIN \n    PrixMoyenCarburant pm\nWHERE \n    p.nom_carburant = 'Gazole'\nORDER BY \n    p.prix ASC\nLIMIT 20; -- On extrait le Top 20 des stations les moins chères",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
